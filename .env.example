# Copy to .env.local and fill locally. Never commit or share .env.local.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional separate OAuth client for Gmail. If omitted, GOOGLE_CLIENT_ID/SECRET are used.
# Register /api/gmail/callback for the exact local port used.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
TODAY_TOKEN_KEY=
TODAY_TOKEN_STORE=
# Optional AI assistance; remains off in the UI until explicitly enabled.
OPENAI_API_KEY=
TODAY_AI_MODEL=
# Optional local model. Install explicitly, then use paths resolved from the repository root; no weights download automatically.
# The packaged manifest pins hashes for every model file. Use a matching model directory.
TODAY_LOCAL_MODEL_DIR=
TODAY_LOCAL_PYTHON=
TODAY_LOCAL_MODEL_MANIFEST=
TODAY_LOCAL_MODEL_PORT=8092
# Experimental Today Model Gamma adapter, if separately installed and verified.
TODAY_LOCAL_ADAPTER_DIR=
TODAY_LOCAL_ADAPTER_MANIFEST=
# Optional operator-configured remote JSON completion service. HTTPS only in normal operation.
# This is independent of the legacy manual-capture OPENAI_API_KEY integration.
TODAY_REMOTE_ENDPOINT=
TODAY_REMOTE_MODEL=
TODAY_REMOTE_API_KEY=
TODAY_REMOTE_PROTOCOL=today-json
# Server-side permission required in addition to the UI's manual consent.
TODAY_REMOTE_ALLOW_LOCAL_PRIVATE=false
# Optional local Ollama daemon. Only loopback is accepted; no model pull is automatic.
TODAY_OLLAMA_MODEL=
TODAY_OLLAMA_ENDPOINT=http://127.0.0.1:11434

# V2.1 experimental local Chat (optional; no model download/start/cloud fallback).
# Existing installed model tag and exact 64-hex manifest digest are both required.
TODAY_CHAT_MODEL=
TODAY_CHAT_DIGEST=
TODAY_CHAT_OLLAMA_URL=http://127.0.0.1:11434

# Optional Chat completion API. Blank by default, no paid API is provisioned.
# Example free self-hosted endpoint: http://127.0.0.1:11434/v1/chat/completions
TODAY_CHAT_API_ENDPOINT=
TODAY_CHAT_API_MODEL=
TODAY_CHAT_API_KEY=
TODAY_CHAT_API_ALLOW_EXTERNAL=false
# Caps attempts per server process (including failures); not a monetary billing cap.
TODAY_CHAT_API_MAX_REQUESTS=100
